# Requerida para partidos reales. Sin clave, /api/fixtures y /api/matches/live
# responden con una simulación (chip «Simulación» en la app).
RAPIDAPI_KEY="TU_API_KEY_AQUI"
RAPIDAPI_HOST="sportapi7.p.rapidapi.com"

# Alias opcionales (el host canónico es RAPIDAPI_HOST)
RAPIDAPI_SPORT_HOST=sportapi7.p.rapidapi.com
RAPIDAPI_SPORT_BASE=https://sportapi7.p.rapidapi.com
# Segundos respecto a UTC. 0 = UTC, 3600 = UTC+1
SPORTAPI_TZ_OFFSET=0

# URL del bono / registro (88 Gallo)
NEXT_PUBLIC_OFFICIAL_SERVER_URL=https://www.88gallo.com
NEXT_PUBLIC_BONUS_URL=https://www.88gallo.com

# Login con Telegram (Login Widget + Mini App)
# En @BotFather: /setdomain con el dominio HTTPS de la Mini App
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_ID=
NEXT_PUBLIC_TELEGRAM_MINI_APP=
# Solo servidor. Sirve para validar initData / el widget.
TELEGRAM_BOT_TOKEN=
